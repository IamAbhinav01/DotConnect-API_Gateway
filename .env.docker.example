# Add these values to the existing .env file before running Docker Compose.
# Use a long, URL-safe MongoDB password (letters and numbers only).
MONGO_ROOT_USERNAME=dotconnect-admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-url-safe-password
JWT_SECRET=replace-with-a-long-random-secret

# Existing Argon2 settings can be kept from your .env; these defaults are used
# by Docker Compose if they are not set.
salt_size=16
TimeCost=2
MemoryCost=65536
Threads=4
KeyLength=32
